{
  "name": "grrc",
  "version": "0.1.0",
  "description": "NestFind workspace with a Next.js PWA and an Anchor escrow program",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "ensure:env": "node scripts/ensure-nestfind-env.mjs",
    "doctor": "pnpm run ensure:env && cd apps/nestfind && node scripts/doctor.mjs",
    "dev": "pnpm run ensure:env && cd apps/nestfind && next dev --webpack",
    "build": "pnpm run ensure:env && cd apps/nestfind && next build --webpack",
    "start": "pnpm run ensure:env && cd apps/nestfind && next start",
    "lint": "cd apps/nestfind && eslint .",
    "reindex": "cd apps/nestfind && node scripts/reindex.mjs",
    "check:couchbase": "pnpm run ensure:env && cd apps/nestfind && node --env-file=.env.local --import tsx scripts/check-couchbase-connection.ts",
    "seed:couchbase": "pnpm run ensure:env && cd apps/nestfind && node --env-file=.env.local --import tsx scripts/seed-couchbase-listings.ts",
    "migrate:demo:couchbase": "pnpm run ensure:env && cd apps/nestfind && node --env-file=.env.local --import tsx scripts/migrate-demo-data-to-couchbase.ts",
    "verify:apartment": "cd apps/nestfind && node --import tsx scripts/verify-apartment.ts",
    "verify:api": "cd apps/nestfind && node --import tsx scripts/verify-api-contracts.ts",
    "typecheck": "cd apps/nestfind && tsc --noEmit",
    "verify": "pnpm run doctor && pnpm run lint && pnpm run typecheck && pnpm run verify:api && pnpm run verify:apartment && pnpm run build",
    "anchor:format": "cd programs/escrow && prettier \"**/*.{js,ts}\" --write",
    "anchor:lint": "cd programs/escrow && prettier \"**/*.{js,ts}\" --check",
    "anchor:initialize:devnet": "cd programs/escrow && node --env-file=../../.env scripts/initialize-devnet.mjs",
    "anchor:typecheck": "cd programs/escrow && tsc --noEmit",
    "sync:idl": "cp programs/escrow/target/idl/escrow.json apps/nestfind/idl/escrow.json",
    "anchor:build": "cd programs/escrow && anchor build && pnpm run sync:idl",
    "anchor:test": "pnpm exec ts-mocha -p programs/escrow/tsconfig.json -t 1000000 programs/escrow/tests/bankrun.test.ts",
    "test": "pnpm run anchor:test",
    "verify:escrow": "pnpm exec ts-mocha -p programs/escrow/tsconfig.json -t 120000 programs/escrow/tests/devnet-e2e.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.39",
    "@anchor-lang/core": "1.0.2",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@solana/web3.js": "^1.98.4",
    "agora-agent-client-toolkit": "1.2.0",
    "agora-agent-uikit": "1.1.0",
    "agora-agents": "^2.3.1",
    "agora-rtc-react": "^2.5.1",
    "agora-rtc-sdk-ng": "^4.24.3",
    "agora-rtm": "^2.2.3",
    "agora-token": "^2.0.5",
    "ai": "^6.0.107",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "couchbase": "^4.4.0",
    "lucide-react": "^0.454.0",
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "anchor-bankrun": "^0.5.0",
    "chai": "^6.2.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.2",
    "mocha": "^11.7.5",
    "postcss": "^8.5.1",
    "prettier": "^3.7.4",
    "solana-bankrun": "^0.4.0",
    "tailwindcss": "^3.4.17",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1"
  }
}
