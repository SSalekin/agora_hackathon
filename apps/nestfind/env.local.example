# ─── Agora ────────────────────────────────────────────────────────────────────
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# UID the AI agent joins the channel with.
# - Must match the agentUid set in app/api/invite-agent/route.ts.
# - (Optional override) Defaults: to 123456 (via lib/agora.ts)
NEXT_PUBLIC_AGENT_UID=123456

# ─── Solana RPC ───────────────────────────────────────────────────────────────
# RPC endpoint used by the browser client for all Solana reads and writes.
# For production, use a private RPC (Helius, Quicknode, etc.) and restrict CORS.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# ─── Couchbase (optional) ─────────────────────────────────────────────────────
# Set USE_COUCHBASE=true and fill in the connection details below to enable Couchbase
# for listings or other persistence. Keep dummy in-memory data unless you migrate it.
USE_COUCHBASE=false
COUCHBASE_CONN_STR=
COUCHBASE_USERNAME=
COUCHBASE_PASSWORD=
COUCHBASE_BUCKET=nestfind
COUCHBASE_SCOPE=_default
COUCHBASE_LISTINGS_COLLECTION=listings

# Escrow documents reuse the same collection by default.
# To separate them into a dedicated Couchbase collection, create the collection
# in Capella and set this env var:
# COUCHBASE_ESCROW_COLLECTION=escrow

# Tip: you can use Couchbase Capella (cloud) free tier instead of running locally.
# See docs/COUCHBASE.md for step-by-step Capella setup and how to fill these values.

# Optional BYOK examples:
# - Uncomment the matching blocks in app/api/invite-agent/route.ts if you want to bring
# - your own vendor credentials instead of using the Agora-managed defaults.
# NEXT_DEEPGRAM_API_KEY=
# NEXT_LLM_URL=https://api.openai.com/v1/chat/completions
# NEXT_LLM_API_KEY=
# NEXT_ELEVENLABS_API_KEY=
# NEXT_ELEVENLABS_VOICE_ID=

# ─── Agent behavior ───────────────────────────────────────────────────────────
# Optional opening line override
# NEXT_AGENT_GREETING=Hi there! I'm Ada, your virtual assistant from Agora. How can I help?
